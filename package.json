{
  "name": "fleet-billing",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "db:migrate": "pnpm --filter @fleet/api db:migrate",
    "db:seed": "pnpm --filter @fleet/api db:seed"
  }
}
