# Copy to .env.local (git-ignored). Both apps read the root .env.local.
# All values below are placeholders.

# --- Supabase (Project Settings → API Keys / Connect) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Server only. Used by the seed script to create the demo login users.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Only needed if your project still uses the legacy HS256 JWT secret (new projects use JWKS).
# SUPABASE_JWT_SECRET=

# Transaction pooler (port 6543) for the running API
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler / direct connection (port 5432) for migrations and seed
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# From `stripe listen --forward-to localhost:4000/stripe/webhook`, or the dashboard endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- App ---
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Password for the two seeded demo accounts
DEMO_PASSWORD=change-me-demo-password
